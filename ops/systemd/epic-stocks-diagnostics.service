[Unit]
Description=Collect safe Epic Stocks host diagnostics
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 @DEPLOY_PATH@/ops/collect_diagnostics.py --environment @APP_ENV@
StateDirectory=epic-stocks-diagnostics
StateDirectoryMode=0755
UMask=0077
TimeoutStartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
